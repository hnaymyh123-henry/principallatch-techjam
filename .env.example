# Browser/server
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen. Generate it
# independently; it must never equal the Agent-readable MODEL_API_KEY.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token
# Comma-separated exact browser origins for non-loopback deployments.
# Loopback :3000 and development :5173 origins are included automatically.
# APP_ALLOWED_ORIGINS=https://principallatch.example.com

# PrincipalLatch. Keys are generated once with 0600 permissions under APP_DATA_DIR.
# Keep the 300-second TTL for the same-Passport revocation demo.
PRINCIPALLATCH_PASSPORT_TTL_SECONDS=300
PRINCIPALLATCH_GATEWAY_RATE_LIMIT_MAX=120
SESSION_COOKIE_SECURE=false
# Override only when the Runtime reaches the gateway through another address.
# PRINCIPALLATCH_GATEWAY_URL=http://host.docker.internal:3000
# Generated random mock canaries live only in APP_DATA_DIR by default.
# PRINCIPALLATCH_PROTECTED_CONTENT_FILE=/trusted/path/mock-content.json
# Set SESSION_COOKIE_SECURE=true only behind an HTTPS origin.

# Model provider. The submitted path uses TokenDance's OpenAI-compatible
# Responses API and its Codex-supported DeepSeek model.
MODEL_API_KEY=replace-with-your-model-api-key
MODEL_ID=deepseek-v4-flash-0731
MODEL_BASE_URL=https://tokendance.space/gateway/v1
MODEL_PROVIDER_ID=tokendance
MODEL_PROVIDER_NAME=TokenDance
MODEL_APP_URL=app://principallatch-techjam

# Trusted host paths used by the supported local launcher.
APP_DATA_DIR=.local/data
AGENT_WORKSPACE_ROOT=.local/workspaces
CODEX_HOME=.local/codex-home
CODEX_BIN=codex

# Codex runs only inside a fresh, disposable Runtime container. The trusted
# Fastify control plane stays outside it and never mounts keys or protected data.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Runtime provider. local-process is an explicitly insecure development preview
# and is not eligible for the security demo.
RUNTIME_PROVIDER=container
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=principallatch-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000
